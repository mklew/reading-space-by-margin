# Local development uses PGlite when DATABASE_URL is unset.
READER_DATA_DIR=.reader-data
# Generate independently for each environment; never commit real values.
SETUP_SECRET=
CRON_SECRET=
# Required in production. Use a pooled PostgreSQL connection with TLS.
DATABASE_URL=
# Exact public origin, with no path. Set to the deployment's canonical URL.
APP_ORIGIN=http://localhost:3000
