  "private": true,
  "scripts": {
    "margin": "node scripts/margin.mjs",
    "mcp": "node scripts/margin-mcp.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
