    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "ipaddr.js": "^2.5.0",
    "jsdom": "26.1.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
